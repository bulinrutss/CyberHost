# Aplicação
APP_NAME=VPS Host Panel
APP_ENVIRONMENT=development
# Em produção, use um segredo aleatório com pelo menos 32 caracteres.
SECRET_KEY=change-me-to-a-random-64-char-string
DATABASE_URL=mysql+pymysql://root@127.0.0.1:3306/vps_host?charset=utf8mb4
# Banco e segredo isolados do Financeiro (opção 2).
# Se vazio, deriva DATABASE_URL trocando vps_host→financeiro e SECRET_KEY+":financeiro".
# FINANCE_DATABASE_URL=mysql+pymysql://root@127.0.0.1:3306/financeiro?charset=utf8mb4
# FINANCE_SECRET_KEY=change-me-finance-secret-independent
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Produção: CORS_ORIGINS=https://ruts.dev

# VMware ESXi 6.7 (standalone)
ESXI_HOST=192.168.0.125
ESXI_USER=root
ESXI_PASSWORD=
ESXI_PORT=443
ESXI_DISABLE_SSL_VERIFY=false
# SHA-256 do certificado TLS do ESXi (hex). Obrigatório em produção se não houver CA.
# ESXI_SSL_PIN_SHA256=
# Opcional: PEM da CA/certificado do ESXi
# ESXI_SSL_CA_FILE=
# Legado (health check). Clones usam: VPS-BASE-SV2016, VPS-BASE-SV2019
ESXI_TEMPLATE_NAME=VPS-BASE-SV2016
ESXI_DATASTORE=datastore1
ESXI_NETWORK=VM Network

# Pool de IPs para novas VPS (rede local do host)
IP_POOL_START=192.168.0.200
IP_POOL_END=192.168.0.250
IP_SUBNET_MASK=255.255.255.0
IP_GATEWAY=192.168.0.1
IP_DNS_PRIMARY=8.8.8.8
IP_DNS_SECONDARY=8.8.4.4

# Conta/senha dos templates Windows (antes da troca automática no provisionamento).
# A senha de cada VPS no banco é cifrada (enc:v1:); GUEST_ADMIN_* é só a senha do template.
GUEST_ADMIN_USER=Administrador
GUEST_ADMIN_PASSWORD=
# Opcional: senha diferente por template (se vazio, usa GUEST_ADMIN_PASSWORD)
# GUEST_ADMIN_PASSWORD_SV2012=
# GUEST_ADMIN_PASSWORD_SV2016=
# GUEST_ADMIN_PASSWORD_SV2019=

# Abacate Pay (API v2)
ABACATEPAY_API_KEY=
ABACATEPAY_WEBHOOK_SECRET=
ABACATEPAY_BASE_URL=https://api.abacatepay.com/v2
ABACATEPAY_ENABLED=true

# Modo de teste: provisiona VPS sem pagamento (false = exige checkout)
SKIP_PAYMENT_FOR_TESTING=false

# URLs públicas (redirects do checkout e webhook). Produção exige HTTPS.
FRONTEND_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:8810
# Produção: FRONTEND_URL=https://ruts.dev  API_PUBLIC_URL=https://ruts.dev
# Ticket de uso único do WebSocket do console (segundos; 15–300).
# CONSOLE_WS_TICKET_SECONDS=60
# Confirmação de telefone no cadastro (WhatsApp Cloud API — templates AUTHENTICATION).
# Desligado até você criar o app/WABA, o template e o token permanente.
# WHATSAPP_ENABLED=true
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TEMPLATE_NAME=verification_code
# WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
# WHATSAPP_GRAPH_VERSION=v22.0
# WHATSAPP_OTP_TTL_SECONDS=600
# WHATSAPP_RESEND_SECONDS=60
# Confirmação de e-mail no cadastro (SMTP). Confirma o endereço, não o celular.
# EMAIL_OTP_ENABLED=true
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USERNAME=resend
# SMTP_PASSWORD=
# SMTP_FROM=cyberhost@ruts.dev
# SMTP_FROM_NAME=CyberHost
# SMTP_STARTTLS=true
# SMTP_SSL=false
# Lembretes de vencimento VPS/CyberCloud (10/5/3/2/1 dia e 5 dias após).
# BILLING_REMINDER_ENABLED=true
# AUTH_LOGIN_IP_MAX=20
# AUTH_LOGIN_IP_WINDOW_SECONDS=600
# AUTH_LOGIN_PHONE_FAIL_MAX=8
# AUTH_LOGIN_PHONE_WINDOW_SECONDS=900
# AUTH_REGISTER_IP_MAX=5
# AUTH_REGISTER_IP_WINDOW_SECONDS=3600
# AUTH_MFA_TICKET_SECONDS=120
# AUTH_ACCESS_MINUTES=15
# AUTH_REFRESH_HOURS=12
# WEBAUTHN_RP_ID=ruts.dev
# WEBAUTHN_RP_NAME=CyberHost
# WEBAUTHN_ORIGIN=https://ruts.dev
# TOTP no login de admin. false = senha basta; true = exige 2FA no login administrativo.
ADMIN_MFA_REQUIRED=true

# Bootstrap do admin (telefone E.164 sem +). Cria a conta só se o telefone não existir.
# Depois da primeira inicialização a senha do .env é ignorada — rotacione pelo painel.
# Pode esvaziar ADMIN_PASSWORD após o bootstrap; o restart não restaura senha antiga.
ADMIN_PHONE=11999999999
ADMIN_PASSWORD=change-me-admin-password

# Cloud de arquivos (fragmentos via Discord — tamanho = limite anexo − 1 KB)
CLOUD_FILES_PATH=./data/cloud_files
CLOUD_FILES_QUOTA_BYTES=5368709120
# Espaço CyberCloud incluído em toda conta nova (GB)
CLOUD_FILES_ACCOUNT_BASE_QUOTA_GB=20
# Pacotes extras de armazenamento: GB:preco_centavos (R$), separados por vírgula
CLOUD_STORAGE_PACKAGES=50:990,100:1790,250:3990
# Tamanho máximo por arquivo no upload — use GB (recomendado) ou MB
CLOUD_FILES_MAX_UPLOAD_GB=20
# CLOUD_FILES_MAX_UPLOAD_MB=200
# Opcional: limite exato em bytes (só se GB e MB não estiverem no .env)
# CLOUD_FILES_MAX_UPLOAD_BYTES=209715200
# Limite de banda total do cloud no servidor (megabits/s, decimal). 0 = ilimitado.
# Ex.: 100 = ~12,5 MB/s compartilhado entre receber fragmentos, Discord e downloads.
CLOUD_FILES_BANDWIDTH_LIMIT_MBPS=0
# Uploads incompletos simultâneos por usuário (reserva de cota / staging)
# CLOUD_FILES_MAX_CONCURRENT_UPLOADS=5
# Teto do POST HTTP. O nginx na frente (1.18) recusa >1 MB (413). 0 = só Discord.
CLOUD_FILES_HTTP_CHUNK_MAX_BYTES=786432
CLOUD_FILES_STORAGE_BACKEND=discord
# Limite de anexo por mensagem na API Discord (padrão 10 MiB = 10485760)
# Servidor com boost: tier 1 = 50 MB, tier 2 = 100 MB, tier 3 = 500 MB
DISCORD_ATTACHMENT_LIMIT_BYTES=10485760

# Bots Discord — tokens separados por vírgula (até 10+ bots, cada um com rate limit próprio)
# Crie uma Application por bot no Developer Portal e convide todos ao mesmo canal
DISCORD_BOT_TOKENS=token_bot1,token_bot2,token_bot3,token_bot4,token_bot5,token_bot6,token_bot7,token_bot8,token_bot9,token_bot10
# Legado: um único bot (usado se DISCORD_BOT_TOKENS estiver vazio)
DISCORD_BOT_TOKEN=
# Clique direito no canal → Copiar ID (Modo desenvolvedor ativo)
DISCORD_STORAGE_CHANNEL_ID=
# Segundos entre cada chamada à API do Discord (upload/download). Aumente se der rate limit (ex: 5)
DISCORD_UPLOAD_INTERVAL_SECONDS=3
# Cache de URLs CDN (segundos; links expiram ~24 h)
DISCORD_URL_CACHE_SECONDS=79200
# Presença online: serviço systemd cyberhost-discord (Gateway). Sobe com o painel no boot.

# Servidores de jogo (SA-MP, MTA, Minecraft)
GAME_SERVERS_ENABLED=true
GAME_SERVERS_DATA_PATH=./data/game_servers
# IP público exibido aos clientes (host Linux de produção)
GAME_HOST_PUBLIC_IP=127.0.0.1
# Proxy Manager — HTTPS + token (em produção o backend fala com um gateway local)
# PORT_PROXY_API_URL=https://127.0.0.1:5443
# PORT_PROXY_API_TOKEN=
# PORT_PROXY_TLS_PIN_SHA256=
# PORT_PROXY_TLS_CA_FILE=
# PORT_PROXY_TLS_INSECURE=false
# IP público nas credenciais/portas da VPS (vazio = usa GAME_HOST_PUBLIC_IP)
# VPS_PUBLIC_IP=132.255.58.65
GAME_PORT_RANGE_START=27000
GAME_PORT_RANGE_END=27999
GAME_HOST_MAX_SERVERS=50
# Arquivos do servidor de jogo (edição no painel, upload, cota da pasta)
# GAME_FILES_MAX_EDIT_BYTES=2097152
# GAME_FILES_MAX_UPLOAD_BYTES=52428800
# GAME_FILES_QUOTA_BYTES=10737418240
# Explorador/SSH do host no painel admin (só administradores)
# HOST_FILES_ROOTS=/opt/host,/var/www/ruts
# HOST_FILES_MAX_EDIT_BYTES=2097152
# HOST_FILES_MAX_UPLOAD_BYTES=52428800
# HOST_SHELL_ENABLED=true
# HOST_SHELL_CWD=/opt/host
# Isolamento do processo (Linux). Usuário system sem login.
# GAME_PROCESS_ISOLATE=true
# GAME_PROCESS_USER=cyberhost-game
# GAME_PROCESS_OWNER=rts
# GAME_PROCESS_CPU_QUOTA_PERCENT=100
# GAME_PROCESS_TASKS_MAX=128
# Binários reais no host Linux (deixe vazio para modo stub em dev/teste)
# GAME_SAMP_BINARY=/opt/samp/samp03svr
# GAME_MTA_BINARY=/opt/mta/mta-server64
# GAME_MINECRAFT_JAVA=java
# GAME_MINECRAFT_JAR=/opt/minecraft/server.jar
# GAME_FIVEM_BINARY=/opt/fxserver/FXServer
# Chave em https://keymaster.fivem.net (OneSync etc.)
# GAME_FIVEM_DEFAULT_LICENSE_KEY=sua_chave_aqui

# Hospedagem de sites (porta alta só em 127.0.0.1 + nginx 80)
WEB_HOSTING_ENABLED=true
WEB_SITES_DATA_PATH=./data/web_sites
WEB_PORT_RANGE_START=30000
WEB_PORT_RANGE_END=30499
# WEB_NGINX_SNIPPET_DIR=/opt/host/data/web_sites/nginx
WEB_NGINX_RELOAD=false
# HTTPS automático (Let's Encrypt) para domínio próprio — cliente só precisa do registro A
# WEB_SSL_ENABLED=true
# WEB_SSL_EMAIL=cyberhost@ruts.dev
# WEB_ACME_WEBROOT=/var/www/acme
# WEB_CERTBOT_BINARY=/usr/bin/certbot
# URL pública para sites sem domínio (ex.: https://ruts.dev ou subdomínio automático slug.ruts.dev)
# WEB_PUBLIC_BASE_URL=https://ruts.dev
# WEB_PLATFORM_SUBDOMAINS_ENABLED=true
# WEB_PLATFORM_BASE_DOMAIN=ruts.dev
# WEB_PHP_BINARY=/usr/bin/php
# WEB_PROCESS_ISOLATE=true
# WEB_PROCESS_USER=cyberhost-web
# WEB_PROCESS_OWNER=rts
# WEB_PROCESS_TASKS_MAX=64
# WEB_FILES_MAX_EDIT_BYTES=2097152
# WEB_FILES_MAX_UPLOAD_BYTES=52428800

# Web Push (Financeiro + CyberHost: pedidos, pagamentos, tickets). Gerar com: python scripts/ensure_vapid.py
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:cyberhost@ruts.dev
# FINANCE_TIMEZONE=America/Sao_Paulo
# FINANCE_EVENT_LEAD_MINUTES=15
