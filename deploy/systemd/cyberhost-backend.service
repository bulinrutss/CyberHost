[Unit]
Description=CyberHost Backend (FastAPI)
After=network-online.target mariadb.service
Wants=network-online.target cyberhost-discord.service
Requires=mariadb.service
PartOf=cyberhost.target

[Service]
Type=simple
User=rts
# Arquivos criados pelo serviço (ex.: cp .env .env.bak) nascem 600.
UMask=0077
WorkingDirectory=/opt/host/backend
EnvironmentFile=/opt/host/backend/.env
ExecStart=/opt/host/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8810 --workers 2
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target cyberhost.target
